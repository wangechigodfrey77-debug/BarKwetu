rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Products: public read, admin write
    match /products/{productId} {
      allow read: if true;
      allow write: if true;
    }
    
    // Categories: public read, admin write
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if true;
    }
    
    // Orders: create allowed, read/write for order lifecycle & tracking
    match /orders/{orderId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }
    
    // Promo Codes: read for coupon check, admin write
    match /promoCodes/{promoId} {
      allow read: if true;
      allow write: if true;
    }
    
    // Settings: public read (delivery fees, store name), write by admin
    match /settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }
    
    // Audit logs: admin action auditing
    match /auditLogs/{logId} {
      allow read, write: if true;
    }

    // Users
    match /users/{userId} {
      allow read, write: if true;
    }

    // Product Reviews: public read, write for authenticated/customer reviews
    match /reviews/{reviewId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
